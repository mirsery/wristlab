#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
runtime="work/stdd-venv/bin/python"
if ! "$runtime" -c 'import yaml; assert yaml.__version__ == "6.0.3"' >/dev/null 2>&1; then
  python3 -m venv work/stdd-venv
  "$runtime" -m pip install -r scripts/requirements-stdd.txt
fi
exec "$runtime" scripts/stdd_cli.py "$@"
